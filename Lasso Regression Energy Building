## Split train/test TERSTRATIFIKASI (kedua puncak Y harus ada di train & test) ----
# Stratifikasi memakai rata-rata peringkat Y1 dan Y2 (keduanya sangat berkorelasi).
strat_folds <- function(key, k) {
  n <- length(key); ord <- order(key, runif(n)); f <- integer(n)
  blocks <- ceiling(seq_len(n) / k)
  for (b in unique(blocks)) {
    idx <- which(blocks == b)
    f[ord[idx]] <- sample(k, length(idx))
  }
  f
}
