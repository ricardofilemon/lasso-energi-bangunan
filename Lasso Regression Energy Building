    Jarque_Bera_p   = jarque_bera_p(res),
    Dip_p_Resid     = dip.test(res)$p.value,     # p kecil -> residual masih multimodal
    Modes_Resid     = count_modes(res, adjust = 1.5),
    Cook_Threshold  = cook_threshold,
    N_Influential   = sum(cooks_d > cook_threshold)
  )
}
