## Repeated cross-validation ----
# 10-fold CV x 5 repeats (outer), fold DISTRATIFIKASI menurut Y. Di setiap outer
# training fold, lambda Lasso dan K mixture dipilih ulang tanpa memakai validation
# fold. Sekaligus mencatat variabel terpilih dan K yang terpilih di tiap fold.
# Waktu komputasi lebih lama dari skrip sebelumnya (mixture); kecilkan N_REPEATS
# atau N_SPLITS bila perlu.
N_SPLITS  <- 10
N_REPEATS <- 5

cv_rows           <- list()
selection_records <- list()
mix_sel_records   <- list()
k_records         <- list()

for (rep_id in seq_len(N_REPEATS)) {
  set.seed(42 + rep_id)
  fold_assign <- strat_folds(strat_key, N_SPLITS)
  
  for (k in seq_len(N_SPLITS)) {
    tr      <- which(fold_assign != k)
    te      <- which(fold_assign == k)
    X_tr    <- df[tr, FEATURES]
    X_te    <- df[te, FEATURES]
    fold_no <- (rep_id - 1) * N_SPLITS + k
    
    for (t in TARGETS) {
      y_tr <- df[[t]][tr]
      y_te <- df[[t]][te]
      fit  <- fit_target_models(X_tr, y_tr, seed = 1000 * rep_id + k)
      
      for (mn in MODEL_NAMES) {
        pred <- predict_model(fit, mn, X_te)
        cv_rows[[length(cv_rows) + 1]] <- tibble(
          Target = t, Model = mn, Repeat = rep_id, Fold = fold_no,
          RMSE = metric_rmse(y_te, pred),
          MAE  = metric_mae(y_te, pred),
          R2   = metric_r2(y_te, pred)
        )
      }
      
      selection_records[[length(selection_records) + 1]] <-
        lasso_coef_table(fit) %>%
        summarise_selection() %>%
        mutate(Target = t, Fold = fold_no)
      
      mix_sel_records[[length(mix_sel_records) + 1]] <-
        mixture_any_table(fit$mixture) %>%
        summarise_selection() %>%
        mutate(Target = t, Fold = fold_no)
      
      k_records[[length(k_records) + 1]] <- tibble(Target = t, Fold = fold_no, K = fit$mixture$K)
    }
  }
  cat("Repeated CV: repeat", rep_id, "dari", N_REPEATS, "selesai\n")
}

